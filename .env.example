# =============================================================================
# MomenKita
#
# Fail ini disalin menjadi .env semasa deploy, jadi nilainya sengaja selamat
# untuk pengeluaran. Untuk pembangunan tempatan, tukar APP_ENV=local dan
# APP_DEBUG=true supaya ralat dipaparkan penuh.
# =============================================================================

APP_NAME=MomenKita
APP_ENV=production

# Jangan sekali-kali hidupkan pada pelayan langsung. APP_DEBUG memaparkan
# jejak ralat penuh kepada sesiapa yang menyebabkan ralat — termasuk kata
# laluan pangkalan data dan kunci aplikasi.
APP_DEBUG=false

APP_KEY=
# Mesti https. Kamera pelayar (getUserMedia) langsung tidak wujud atas HTTP,
# jadi spot ambil gambar akan mati untuk semua tetamu di dewan.
APP_URL=https://majlis.contoh.com

APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ms_MY

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=momenkita
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Kuki sesi hanya dihantar melalui https. Biarkan true dalam pengeluaran.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# Muat turun ZIP dibina di latar belakang, jadi satu pekerja queue mesti
# berjalan pada pelayan:  php artisan queue:work --queue=archives,default
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Panel admin
# -----------------------------------------------------------------------------
# Jana dengan:  php artisan momenkita:password
# Perintah itu mencetak cincangan untuk ditampal di sini. Kata laluan asal
# tidak pernah disimpan di mana-mana.
ADMIN_PASSWORD_HASH=

# Sandaran teks biasa untuk pemasangan pantas. Kosongkan ini sebaik
# ADMIN_PASSWORD_HASH diisi.
ADMIN_PASSWORD=
